<?xml version="1.0" encoding="UTF-8"?>
<!--
  The converter (AGENTS.md §4): loads wulfquest/data/ with the Java game's own
  Content.load and writes build/gen/ for the C build. Its parent is the Java
  game's, so the versions of Java, Jackson and JUnit follow the submodule.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>wulf</groupId>
    <artifactId>wulfquest-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../wulfquest/pom.xml</relativePath>
  </parent>

  <groupId>wulfmsx</groupId>
  <artifactId>wulfquest-msx-convert</artifactId>
  <name>Wulf Quest MSX2 converter</name>

  <dependencies>
    <dependency>
      <groupId>wulf</groupId>
      <artifactId>wulfquest-core</artifactId>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
      <!-- build.sh runs it with exec:java, which runs inside Maven: the paths are absolute. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <configuration>
          <mainClass>wulfmsx.convert.Convert</mainClass>
          <arguments>
            <argument>${project.basedir}/../wulfquest/data</argument>
            <argument>${project.basedir}/../build/gen</argument>
          </arguments>
        </configuration>
        <executions>
          <!-- test/rooms.sh: exec:java@render-rooms, every room as the Java game draws it. -->
          <execution>
            <id>render-rooms</id>
            <configuration>
              <mainClass>wulfmsx.convert.RenderRooms</mainClass>
              <arguments>
                <argument>${project.basedir}/../wulfquest/data</argument>
                <argument>${project.basedir}/../build/test/rooms_expected.bin</argument>
              </arguments>
            </configuration>
          </execution>
          <!-- tools/record-demo.sh: exec:java@demo-route, the keys it plays into the MSX. -->
          <execution>
            <id>demo-route</id>
            <configuration>
              <mainClass>wulfmsx.convert.DemoRoute</mainClass>
              <arguments>
                <argument>${project.basedir}/../wulfquest/data</argument>
                <argument>${project.basedir}/../build/test/demo_route.txt</argument>
                <argument>${demo.seed}</argument>
                <argument>${demo.ticks}</argument>
                <argument>${demo.swing}</argument>
              </arguments>
            </configuration>
          </execution>
          <!-- test/moves.sh: exec:java@move-traces, Vale as the Java game moves him. -->
          <execution>
            <id>move-traces</id>
            <configuration>
              <mainClass>wulfmsx.convert.MoveTraces</mainClass>
              <arguments>
                <argument>${project.basedir}/../wulfquest/data</argument>
                <argument>${project.basedir}/../test/moves.json</argument>
                <argument>${project.basedir}/../build/test/moves</argument>
              </arguments>
            </configuration>
          </execution>
          <!-- test/moves.sh: exec:java@jungle-traces, M6's jungle as the Java game runs it. -->
          <execution>
            <id>jungle-traces</id>
            <configuration>
              <mainClass>wulfmsx.convert.MoveTraces</mainClass>
              <arguments>
                <argument>${project.basedir}/../wulfquest/data</argument>
                <argument>${project.basedir}/../test/jungle.json</argument>
                <argument>${project.basedir}/../build/test/jungle</argument>
              </arguments>
            </configuration>
          </execution>
          <!-- test/moves.sh: exec:java@quest-traces, M7's quest and Wulf as the Java game runs them. -->
          <execution>
            <id>quest-traces</id>
            <configuration>
              <mainClass>wulfmsx.convert.MoveTraces</mainClass>
              <arguments>
                <argument>${project.basedir}/../wulfquest/data</argument>
                <argument>${project.basedir}/../test/quest.json</argument>
                <argument>${project.basedir}/../build/test/quest</argument>
              </arguments>
            </configuration>
          </execution>
          <!-- test/moves.sh: exec:java@game-traces, M8's whole game as the Java game runs it. -->
          <execution>
            <id>game-traces</id>
            <configuration>
              <mainClass>wulfmsx.convert.MoveTraces</mainClass>
              <arguments>
                <argument>${project.basedir}/../wulfquest/data</argument>
                <argument>${project.basedir}/../test/game.json</argument>
                <argument>${project.basedir}/../build/test/game</argument>
              </arguments>
            </configuration>
          </execution>
          <!-- test/moves.sh: exec:java@flip-traces, M4's flips as the Java game makes them. -->
          <execution>
            <id>flip-traces</id>
            <configuration>
              <mainClass>wulfmsx.convert.MoveTraces</mainClass>
              <arguments>
                <argument>${project.basedir}/../wulfquest/data</argument>
                <argument>${project.basedir}/../test/flips.json</argument>
                <argument>${project.basedir}/../build/test/flips</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
